{
  "name": "@fuad24/gitbridge",
  "version": "0.1.1",
  "description": "Universal Git Identity & Multi-Account Management Layer",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gitbridge": "dist/bin/gitbridge.js",
    "gb": "dist/bin/gb.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run bin/gitbridge.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "bun x tsc --noEmit",
    "build": "bun run scripts/build.ts && bun x tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run test && bun run build"
  },
  "keywords": [
    "git",
    "identity",
    "multi-account",
    "github",
    "gitlab",
    "bitbucket",
    "ssh",
    "credential-helper",
    "cli"
  ],
  "author": "Fuad Tesfaye",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FuadTesfaye/gitbridge.git"
  },
  "bugs": {
    "url": "https://github.com/FuadTesfaye/gitbridge/issues"
  },
  "homepage": "https://github.com/FuadTesfaye/gitbridge#readme",
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@fuad24/gitbridge": "^0.1.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.13.9",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
