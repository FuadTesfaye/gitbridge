{
  "name": "gitbridge",
  "version": "0.1.0",
  "description": "Universal Git Identity & Multi-Account Management Layer",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "gitbridge": "./bin/gitbridge.ts",
    "gb": "./bin/gitbridge.ts"
  },
  "scripts": {
    "start": "bun run bin/gitbridge.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "bun x tsc --noEmit",
    "build": "bun build bin/gitbridge.ts --outdir ./dist --target node"
  },
  "keywords": [
    "git",
    "identity",
    "multi-account",
    "github",
    "gitlab",
    "bitbucket",
    "ssh",
    "credential-helper"
  ],
  "author": "Fuad Tesfaye",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  }
}
