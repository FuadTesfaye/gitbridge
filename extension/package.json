{
  "name": "gitbridge-vscode",
  "displayName": "GitBridge",
  "description": "Universal Git Identity & Multi-Account Management Layer for VS Code, Cursor, and Antigravity IDE",
  "version": "0.1.0",
  "publisher": "fuadtesfaye",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FuadTesfaye/gitbridge"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "identity",
    "multi-account",
    "github",
    "gitlab",
    "bitbucket",
    "ssh",
    "credential-helper",
    "cursor",
    "antigravity"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitbridge-explorer",
          "title": "GitBridge",
          "icon": "media/gitbridge-icon.svg"
        }
      ]
    },
    "views": {
      "gitbridge-explorer": [
        {
          "id": "gitbridge.context",
          "name": "Active Context"
        },
        {
          "id": "gitbridge.identities",
          "name": "Git Identities"
        },
        {
          "id": "gitbridge.accounts",
          "name": "Accounts & Providers"
        },
        {
          "id": "gitbridge.rules",
          "name": "Directory Rules"
        }
      ],
      "scm": [
        {
          "id": "gitbridge.scm.context",
          "name": "GitBridge Identity"
        }
      ]
    },
    "commands": [
      {
        "command": "gitbridge.showStatusBarMenu",
        "title": "GitBridge: Identity & Context Quick Menu",
        "category": "GitBridge",
        "icon": "$(person)"
      },
      {
        "command": "gitbridge.switchIdentity",
        "title": "GitBridge: Switch Git Identity",
        "category": "GitBridge",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "gitbridge.setDefaultIdentity",
        "title": "GitBridge: Set Default Identity",
        "category": "GitBridge",
        "icon": "$(star)"
      },
      {
        "command": "gitbridge.removeIdentity",
        "title": "GitBridge: Delete Identity",
        "category": "GitBridge",
        "icon": "$(trash)"
      },
      {
        "command": "gitbridge.fixMismatch",
        "title": "GitBridge: Fix Repository Email Mismatch",
        "category": "GitBridge",
        "icon": "$(tools)"
      },
      {
        "command": "gitbridge.toggleSafetyHook",
        "title": "GitBridge: Toggle Pre-Commit Safety Guard",
        "category": "GitBridge",
        "icon": "$(shield)"
      },
      {
        "command": "gitbridge.initRepo",
        "title": "GitBridge: Initialize Repository Profile",
        "category": "GitBridge",
        "icon": "$(repo)"
      },
      {
        "command": "gitbridge.addIdentity",
        "title": "GitBridge: Add Git Identity",
        "category": "GitBridge",
        "icon": "$(add)"
      },
      {
        "command": "gitbridge.addRule",
        "title": "GitBridge: Add Directory Rule",
        "category": "GitBridge",
        "icon": "$(add)"
      },
      {
        "command": "gitbridge.removeRule",
        "title": "GitBridge: Delete Directory Rule",
        "category": "GitBridge",
        "icon": "$(trash)"
      },
      {
        "command": "gitbridge.openDirectoryRule",
        "title": "GitBridge: Open Rule Directory",
        "category": "GitBridge",
        "icon": "$(folder)"
      },
      {
        "command": "gitbridge.authLogin",
        "title": "GitBridge: Connect Git Provider Account",
        "category": "GitBridge",
        "icon": "$(account)"
      },
      {
        "command": "gitbridge.authLogout",
        "title": "GitBridge: Disconnect Account",
        "category": "GitBridge",
        "icon": "$(sign-out)"
      },
      {
        "command": "gitbridge.pushAll",
        "title": "GitBridge: Push to All Remotes",
        "category": "GitBridge",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitbridge.doctor",
        "title": "GitBridge: Run System Diagnostics (Doctor)",
        "category": "GitBridge",
        "icon": "$(pulse)"
      },
      {
        "command": "gitbridge.enable",
        "title": "GitBridge: Enable Git Integration",
        "category": "GitBridge"
      },
      {
        "command": "gitbridge.disable",
        "title": "GitBridge: Disable Git Integration",
        "category": "GitBridge"
      },
      {
        "command": "gitbridge.enableOverride",
        "title": "GitBridge: Enable Native Git Override",
        "category": "GitBridge",
        "icon": "$(zap)"
      },
      {
        "command": "gitbridge.disableOverride",
        "title": "GitBridge: Disable Native Git Override",
        "category": "GitBridge",
        "icon": "$(circle-slash)"
      },
      {
        "command": "gitbridge.toggleOverride",
        "title": "GitBridge: Toggle Native Git Override",
        "category": "GitBridge",
        "icon": "$(zap)"
      },
      {
        "command": "gitbridge.syncIde",
        "title": "GitBridge: Sync IDE with GitBridge",
        "category": "GitBridge",
        "icon": "$(sync)"
      },
      {
        "command": "gitbridge.unsyncIde",
        "title": "GitBridge: Unsync IDE Configuration",
        "category": "GitBridge",
        "icon": "$(trash)"
      },
      {
        "command": "gitbridge.refresh",
        "title": "GitBridge: Refresh Explorer",
        "category": "GitBridge",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "gitbridge.showStatusBarMenu",
        "key": "ctrl+alt+g m",
        "mac": "cmd+alt+g m"
      },
      {
        "command": "gitbridge.switchIdentity",
        "key": "ctrl+alt+g s",
        "mac": "cmd+alt+g s"
      },
      {
        "command": "gitbridge.doctor",
        "key": "ctrl+alt+g d",
        "mac": "cmd+alt+g d"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitbridge.refresh",
          "when": "view =~ /^gitbridge\\./",
          "group": "navigation@1"
        },
        {
          "command": "gitbridge.addIdentity",
          "when": "view == gitbridge.identities",
          "group": "navigation@2"
        },
        {
          "command": "gitbridge.authLogin",
          "when": "view == gitbridge.accounts",
          "group": "navigation@2"
        },
        {
          "command": "gitbridge.addRule",
          "when": "view == gitbridge.rules",
          "group": "navigation@2"
        },
        {
          "command": "gitbridge.doctor",
          "when": "view =~ /^gitbridge\\./",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "gitbridge.switchIdentity",
          "when": "viewItem == gitbridge-identity || viewItem == gitbridge-context-identity",
          "group": "inline@1"
        },
        {
          "command": "gitbridge.setDefaultIdentity",
          "when": "viewItem == gitbridge-identity",
          "group": "inline@2"
        },
        {
          "command": "gitbridge.removeIdentity",
          "when": "viewItem == gitbridge-identity",
          "group": "inline@3"
        },
        {
          "command": "gitbridge.fixMismatch",
          "when": "viewItem == gitbridge-context-mismatch",
          "group": "inline@1"
        },
        {
          "command": "gitbridge.toggleSafetyHook",
          "when": "viewItem == gitbridge-context-safety-hook",
          "group": "inline@1"
        },
        {
          "command": "gitbridge.openDirectoryRule",
          "when": "viewItem == gitbridge-rule",
          "group": "inline@1"
        },
        {
          "command": "gitbridge.removeRule",
          "when": "viewItem == gitbridge-rule",
          "group": "inline@2"
        },
        {
          "command": "gitbridge.authLogout",
          "when": "viewItem == gitbridge-account",
          "group": "inline@1"
        },
        {
          "command": "gitbridge.pushAll",
          "when": "viewItem == gitbridge-context-remotes",
          "group": "inline@1"
        },
        {
          "command": "gitbridge.toggleOverride",
          "when": "viewItem == gitbridge-context-override",
          "group": "inline@1"
        },
        {
          "command": "gitbridge.syncIde",
          "when": "viewItem == gitbridge-context-ide",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "GitBridge",
      "properties": {
        "gitbridge.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the active GitBridge identity badge in the status bar."
        },
        "gitbridge.statusBar.showEmail": {
          "type": "boolean",
          "default": true,
          "description": "Display email alongside identity name in the status bar."
        },
        "gitbridge.safety.warnOnMismatch": {
          "type": "boolean",
          "default": true,
          "description": "Show a non-intrusive warning when the repository git email does not match the active directory rule."
        },
        "gitbridge.ide.autoSyncGitPath": {
          "type": "boolean",
          "default": true,
          "description": "Automatically synchronize VS Code 'git.path' and terminal environment with GitBridge shims when enabled."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "package": "bun x @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "zod": "^3.24.2"
  }
}
